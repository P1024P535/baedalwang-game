rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) {
   return request.auth != null && request.auth.uid == uid
    && request.auth.token.firebase.sign_in_provider == 'google.com';
  }
  function validSave() {
   let d = request.resource.data;
   return d.keys().hasAll(['save','total','ver','rev','updated'])
    && d.keys().hasOnly(['save','total','ver','rev','updated'])
    && d.save is string && d.save.size() > 0 && d.save.size() <= 500000
    && d.total is number && d.total >= 0
    && d.ver == '1.0.3' && d.rev is int
    && d.updated == request.time;
  }
  match /users/{uid} {
   allow get, delete: if owner(uid);
   allow create: if owner(uid) && validSave() && request.resource.data.rev == 1;
   allow update: if owner(uid) && validSave() && request.resource.data.rev == resource.data.rev + 1;
  }
  // Public rankings and purchase entitlements need server verification before activation.
  match /{document=**} { allow read, write: if false; }
 }
}
