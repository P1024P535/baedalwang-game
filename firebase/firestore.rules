rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function identity(uid) {return request.auth != null && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider == 'google.com';}
  function owner(uid) {return identity(uid) && !exists(/databases/$(database)/documents/deletedAccounts/$(uid));}
  function validSave() {
   let d = request.resource.data;
   return d.keys().hasAll(['save','total','ver','rev','updated'])
    && d.keys().hasOnly(['save','total','ver','rev','updated'])
    && d.save is string && d.save.size() > 0 && d.save.size() <= 500000
    && d.total is number && d.total >= 0
    && d.ver in ['1.0.3','1.0.4'] && d.rev is int
    && d.updated == request.time;
  }
  match /users/{uid} {
   allow get: if owner(uid);
   allow delete: if identity(uid);
   allow create: if owner(uid) && validSave() && request.resource.data.rev == 1;
   allow update: if owner(uid) && validSave() && request.resource.data.rev == resource.data.rev + 1;
  }
  match /deletedAccounts/{uid} {
   allow get: if identity(uid);
   allow create: if owner(uid) && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
  }
  function google() {
   return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'
    && !exists(/databases/$(database)/documents/deletedAccounts/$(request.auth.uid));
  }
  function score(d) {
   return d.nick is string && d.nick.size() > 0 && d.nick.size() <= 32
    && d.total is number && d.total >= 0 && d.total <= math.pow(10,300)
    && d.maxIps is number && d.maxIps >= 0 && d.maxIps <= math.pow(10,300)
    && d.lv is int && d.lv >= 1 && d.lv <= 10000000
    && d.region is int && d.region >= 0 && d.region <= 8
    && d.clears is int && d.clears >= 0 && d.clears <= 1000000
    && d.prog is int && d.prog == d.clears * 9 + d.region
    && d.dex is int && d.dex >= 0 && d.dex <= 1000000
    && d.boss is int && d.boss >= 0 && d.boss <= 1000000000000
    && d.updated == request.time;
  }
  function boundedQuery() {return request.query.limit != null && request.query.limit <= 1000;}
  function paced() {return request.time >= resource.data.updated + duration.value(3,'s');}
  match /ranks/{uid} {
   allow get: if google();
   allow list: if google() && boundedQuery();
   allow create: if owner(uid) && score(request.resource.data)
    && request.resource.data.keys().hasOnly(['nick','total','maxIps','lv','region','clears','prog','dex','boss','updated']);
   allow update: if owner(uid) && paced() && score(request.resource.data)
    && request.resource.data.keys().hasOnly(['nick','total','maxIps','lv','region','clears','prog','dex','boss','updated']);
   allow delete: if identity(uid);
  }
  match /weeks/{week} {
   allow get: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
   allow list: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com' && boundedQuery();
   allow create, update: if google() && week.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
    && request.resource.data.keys().hasOnly(['week']) && request.resource.data.week == week;
   match /entries/{uid} {
    allow get: if google();
    allow list: if google() && boundedQuery();
    allow create: if owner(uid) && week.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
     && existsAfter(/databases/$(database)/documents/weeks/$(week)) && score(request.resource.data)
     && request.resource.data.points is number && request.resource.data.points >= 0 && request.resource.data.points <= 1000000000
     && request.resource.data.keys().hasOnly(['nick','total','maxIps','lv','region','clears','prog','dex','boss','updated','points']);
    allow update: if owner(uid) && week.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
     && existsAfter(/databases/$(database)/documents/weeks/$(week)) && paced() && score(request.resource.data)
     && request.resource.data.points is number && request.resource.data.points >= 0 && request.resource.data.points <= 1000000000
     && request.resource.data.keys().hasOnly(['nick','total','maxIps','lv','region','clears','prog','dex','boss','updated','points']);
    allow delete: if identity(uid);
   }
  }
  match /{document=**} { allow read, write: if false; }
 }
}
